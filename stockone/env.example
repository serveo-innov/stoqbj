APP_NAME=StockOne
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://stockone.test

APP_TIMEZONE=Africa/Porto-Novo

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────────────────────
# BASE DE DONNÉES — Laragon MySQL local
# ──────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stockone
DB_USERNAME=root
DB_PASSWORD=

# ──────────────────────────────────────────
# QUEUES — database (pas besoin de Redis)
# Passer sur redis en production
# ──────────────────────────────────────────
QUEUE_CONNECTION=database
QUEUE_FAILED_TABLE=failed_jobs

# ──────────────────────────────────────────
# CACHE — file (Laragon, pas de Redis requis)
# ──────────────────────────────────────────
CACHE_STORE=file
CACHE_PREFIX=stockone_

# ──────────────────────────────────────────
# SESSIONS
# ──────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.stockone.test

# ──────────────────────────────────────────
# MAIL — Mailpit intégré dans Laragon
# ──────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@stockone.test"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────
# SANCTUM — Auth JWT SPA
# ──────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,stockone.test
FRONTEND_URL=http://stockone-front.test

# ──────────────────────────────────────────
# SMS — Africa's Talking (prod uniquement)
# ──────────────────────────────────────────
AT_API_KEY=sandbox
AT_USERNAME=sandbox
AT_SENDER_ID=StockOne
AT_ENV=sandbox

# ──────────────────────────────────────────
# STOCKAGE FICHIERS
# ──────────────────────────────────────────
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=

# ──────────────────────────────────────────
# SÉCURITÉ
# ──────────────────────────────────────────
# Clé AES-256 pour chiffrement prix d'achat (32 chars)
PRICE_ENCRYPTION_KEY=changeme32characterslongsecretkey

# Durée de vie du token Sanctum (en minutes) — 8h
SANCTUM_TOKEN_EXPIRATION=480

# ──────────────────────────────────────────
# RAPPORT QUOTIDIEN
# ──────────────────────────────────────────
# Heure de génération automatique (UTC+1 Cotonou = 23h59 local)
DAILY_REPORT_TIME=22:59

# ──────────────────────────────────────────
# ABONNEMENT
# ──────────────────────────────────────────
SUBSCRIPTION_PRICE=35000
SUBSCRIPTION_DAYS=365
SUBSCRIPTION_GRACE_DAYS=7
SUBSCRIPTION_DATA_RETENTION_DAYS=90
